# Copy to /srv/invariance/app/compose/release.env on the deployment VM.
# Public production should use a registry-provided sha256 digest. A commit-tagged
# image built on the deployment VM is acceptable for controlled pre-launch tests.
APP_IMAGE=ghcr.io/OWNER/invariance-research-web@sha256:REPLACE_WITH_IMAGE_DIGEST
MIGRATION_IMAGE=ghcr.io/OWNER/invariance-research-operations@sha256:REPLACE_WITH_IMAGE_DIGEST
APP_GIT_SHA=REPLACE_WITH_FULL_GIT_COMMIT
APP_RELEASE_VERSION=0.1.0
APP_ENV_FILE=/etc/invariance/app/app.env
DATABASE_CA_CERT_PATH=/srv/invariance/postgres/certs/ca.crt
