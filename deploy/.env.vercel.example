# Vercel production environment template.
# Do not commit real secrets. Copy these keys into Vercel Project Settings -> Environment Variables.

# App URLs
APP_URL=https://invarianceresearch.xyz
NEXTAUTH_URL=https://invarianceresearch.xyz
AUTH_URL=https://invarianceresearch.xyz

# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_32_byte_random_secret
NEXTAUTH_SECRET=replace_with_same_value_as_AUTH_SECRET
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_SESSION_DB_CHECK_INTERVAL_MS=300000

# Preview gate / coming soon access
PREVIEW_GATE_ENABLED=true
PREVIEW_GATE_PASSWORD=replace_with_private_preview_password
PREVIEW_GATE_COOKIE_SECRET=replace_with_random_preview_secret

# Database / Supabase Postgres
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DB_PASSWORD@POOLER_HOST.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
POSTGRES_SCHEMA_AUTO_INIT=false
POSTGRES_POOL_MAX=1
POSTGRES_IDLE_TIMEOUT_MS=10000
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# Workers are external containers, not Vercel request-lifetime workers.
WORKER_MODE=external
ALLOW_EMBEDDED_WORKERS=false
INVARIANCE_EMBEDDED_WORKERS=false
INVARIANCE_WORKER_STALE_MS=120000

# Production kill switches. Set to true during incidents or risky deploys.
INVARIANCE_PLATFORM_PAUSED=false
INVARIANCE_QUEUE_PAUSED=false
INVARIANCE_ANALYSIS_QUEUE_PAUSED=false
INVARIANCE_EXPORT_QUEUE_PAUSED=false
INVARIANCE_EXPERIMENT_QUEUE_PAUSED=false
INVARIANCE_ASSISTANT_PAUSED=false

# Rate limits
RATE_LIMITS_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_ANALYSIS_CREATE_MAX=10
RATE_LIMIT_EXPORT_MAX=20
RATE_LIMIT_SHARE_CREATE_MAX=20
RATE_LIMIT_SHARE_ACCESS_MAX=120
RATE_LIMIT_RESEARCH_DESK_MAX=5
RATE_LIMIT_WAITLIST_MAX=5
RATE_LIMIT_PROGRAM_WRITE_MAX=30
RATE_LIMIT_ASSISTANT_MAX=20
RATE_LIMIT_EXPERIMENT_QUEUE_MAX=10

# Cloudflare R2 object storage
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_BUCKET=invariance-research-prod
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=replace_with_r2_access_key_id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_LIFECYCLE_CONFIGURED=false
# Optional, only if you have a public/custom asset domain for signed/read URLs.
# OBJECT_STORAGE_PUBLIC_BASE_URL=https://assets.invarianceresearch.xyz

# Benchmark library
BENCHMARK_PROVIDER=object_storage
BENCHMARK_OBJECT_PREFIX=benchmarks
BENCHMARK_MANIFEST_OBJECT_KEY=benchmarks/manifest.v1.yaml
BENCHMARK_MANIFEST_CACHE_TTL_MS=300000

# Stripe
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_EXPLORER=price_replace_me
STRIPE_PRICE_PRO=price_replace_me
# Keep only if Team is actively sold in Stripe.
# STRIPE_PRICE_TEAM=price_replace_me

# Email
EMAIL_PROVIDER=resend
EMAIL_FROM=Invariance Research <reports@invarianceresearch.xyz>
RESEND_API_KEY=replace_with_resend_api_key

# Admins / Research Desk
ADMIN_EMAILS=you@invarianceresearch.xyz
ADMIN_USER_IDS=
RESEARCH_DESK_ADMIN_EMAILS=you@invarianceresearch.xyz

# LLM / assistant controls for Vercel.
# Keep disabled until provider credentials and cost controls are intentionally enabled.
LLM_INSIGHTS_ENABLED=false
LLM_RESEARCH_ASSISTANT_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=replace_me_only_if_llm_enabled
OPENAI_MODEL=gpt-4.1-mini
LLM_INSIGHTS_TIMEOUT_MS=120000
LLM_RESEARCH_ASSISTANT_TIMEOUT_MS=30000
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
# Optional governed source ingestion services.
YOUTUBE_TRANSCRIPT_PROVIDER_URL=
YOUTUBE_TRANSCRIPT_PROVIDER_TOKEN=
DOCUMENT_OCR_PROVIDER_URL=
DOCUMENT_OCR_PROVIDER_TOKEN=
SOURCE_MALWARE_SCAN_URL=
SOURCE_MALWARE_SCAN_TOKEN=

# Engine bridge is primarily used by external workers. Vercel should not run heavy engine work.
INVARIANCE_ENGINE_TIMEOUT_MS=120000
