# Copy to deploy/.env.worker on the worker host.
# Never commit real DATABASE_URL, R2 keys, Stripe keys, or LLM provider keys.

# Runtime
NODE_ENV=production
APP_ENV=production
APP_URL=https://your-domain.example
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&uselibpqcompat=true
POSTGRES_SCHEMA_AUTO_INIT=false
POSTGRES_POOL_MAX=1
POSTGRES_IDLE_TIMEOUT_MS=10000
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# Workers
INVARIANCE_EMBEDDED_WORKERS=false
WORKER_MODE=external
INVARIANCE_ANALYSIS_WORKER_POLL_MS=5000
INVARIANCE_EXPORT_WORKER_POLL_MS=5000
INVARIANCE_EXPERIMENT_WORKER_POLL_MS=5000
INVARIANCE_WORKER_STALE_MS=120000
INVARIANCE_WORKER_DB_ERROR_BACKOFF_MS=300000
INVARIANCE_WORKER_RUNTIME_ERROR_BACKOFF_MS=60000
INVARIANCE_ANALYSIS_WORKER_CONCURRENCY=1
INVARIANCE_EXPORT_WORKER_CONCURRENCY=1
INVARIANCE_EXPERIMENT_WORKER_CONCURRENCY=1
INVARIANCE_ANALYSIS_JOB_TIMEOUT_MS=900000
INVARIANCE_EXPORT_JOB_TIMEOUT_MS=300000
INVARIANCE_EXPERIMENT_JOB_TIMEOUT_MS=1800000
INVARIANCE_ANALYSIS_WORKER_INSTANCE_ID=analysis-worker-1
INVARIANCE_EXPORT_WORKER_INSTANCE_ID=export-worker-1
INVARIANCE_EXPERIMENT_WORKER_INSTANCE_ID=experiment-worker-1

# Production kill switches. Set to true and restart web/workers to stop new work
# intake while preserving existing records for inspection/recovery.
INVARIANCE_PLATFORM_PAUSED=false
INVARIANCE_QUEUE_PAUSED=false
INVARIANCE_ANALYSIS_QUEUE_PAUSED=false
INVARIANCE_EXPORT_QUEUE_PAUSED=false
INVARIANCE_EXPERIMENT_QUEUE_PAUSED=false
INVARIANCE_ASSISTANT_PAUSED=false

# Abuse controls
RATE_LIMITS_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_ANALYSIS_CREATE_MAX=10
RATE_LIMIT_EXPORT_MAX=20
RATE_LIMIT_SHARE_CREATE_MAX=20
RATE_LIMIT_RESEARCH_DESK_MAX=5
RATE_LIMIT_PROGRAM_WRITE_MAX=30
RATE_LIMIT_ASSISTANT_MAX=20
RATE_LIMIT_EXPERIMENT_QUEUE_MAX=10

# Engine bridge inside Docker
INVARIANCE_PYTHON_BIN=/opt/venv/bin/python
INVARIANCE_BULLETPROOF_BRIDGE_SCRIPT=/opt/invariance_research/scripts/run_bulletproof_engine.py
INVARIANCE_BULLETPROOF_ROOT=/opt/bulletproof_bt

# Object storage / Cloudflare R2
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_BUCKET=invariance-research-prod
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=replace_me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_me
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_LIFECYCLE_CONFIGURED=false

# Benchmark library
BENCHMARK_PROVIDER=object_storage
BENCHMARK_OBJECT_PREFIX=benchmarks
BENCHMARK_MANIFEST_OBJECT_KEY=benchmarks/manifest.v1.yaml
INVARIANCE_BENCHMARK_LIBRARY_ROOT=/opt/invariance_research/data/benchmark-library

# LLM synthesis is optional for launch. Start the llm profile only when this is true.
LLM_INSIGHTS_ENABLED=false
LLM_RESEARCH_ASSISTANT_ENABLED=false
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
OPENAI_API_KEY=replace_me_if_LLM_PROVIDER_openai
OPENAI_MODEL=gpt-4.1-mini
LLM_INSIGHTS_TIMEOUT_MS=120000
LLM_RESEARCH_ASSISTANT_TIMEOUT_MS=30000

# Email
EMAIL_PROVIDER=resend
EMAIL_FROM=Invariance Research <reports@your-domain.example>
RESEND_API_KEY=replace_me

# Stripe is normally needed by the Vercel web app, not workers. Keep here only if
# worker-side health checks or export emails need billing state in your deployment.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_EXPLORER=price_replace_me
STRIPE_PRICE_PRO=price_replace_me
