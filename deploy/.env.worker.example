# Copy to deploy/.env.worker on the worker host.
# Never commit real DATABASE_URL, R2 keys, Stripe keys, or LLM provider keys.

# Runtime
NODE_ENV=production
APP_ENV=production
APP_URL=https://your-domain.example
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
POSTGRES_SCHEMA_AUTO_INIT=false

# Workers
INVARIANCE_EMBEDDED_WORKERS=false
WORKER_MODE=external
INVARIANCE_ANALYSIS_WORKER_POLL_MS=5000
INVARIANCE_EXPORT_WORKER_POLL_MS=5000
INVARIANCE_WORKER_STALE_MS=120000
INVARIANCE_ANALYSIS_WORKER_CONCURRENCY=1
INVARIANCE_EXPORT_WORKER_CONCURRENCY=1
INVARIANCE_ANALYSIS_JOB_TIMEOUT_MS=900000
INVARIANCE_EXPORT_JOB_TIMEOUT_MS=300000
INVARIANCE_ANALYSIS_WORKER_INSTANCE_ID=analysis-worker-1
INVARIANCE_EXPORT_WORKER_INSTANCE_ID=export-worker-1

# Engine bridge inside Docker
INVARIANCE_PYTHON_BIN=/opt/venv/bin/python
INVARIANCE_BULLETPROOF_BRIDGE_SCRIPT=/opt/invariance_research/scripts/run_bulletproof_engine.py

# Object storage / Cloudflare R2
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_BUCKET=invariance-research-prod
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=replace_me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_me
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Benchmark library
BENCHMARK_PROVIDER=object_storage
BENCHMARK_OBJECT_PREFIX=benchmarks
BENCHMARK_MANIFEST_OBJECT_KEY=benchmarks/manifest.v1.yaml
INVARIANCE_BENCHMARK_LIBRARY_ROOT=/opt/invariance_research/data/benchmark-library

# LLM synthesis is optional for launch. Start the llm profile only when this is true.
LLM_INSIGHTS_ENABLED=false
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
LLM_INSIGHTS_TIMEOUT_MS=120000

# Email
EMAIL_PROVIDER=resend
EMAIL_FROM=Invariance Research <reports@your-domain.example>
RESEND_API_KEY=replace_me

# Stripe is normally needed by the Vercel web app, not workers. Keep here only if
# worker-side health checks or export emails need billing state in your deployment.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_EXPLORER=price_replace_me
STRIPE_PRICE_PRO=price_replace_me
